{
  "name": "telinha-desktop",
  "productName": "Telinha",
  "version": "1.1.0",
  "private": true,
  "description": "Telinha para Windows: transmite a janela do jogo com o som do computador.",
  "author": "Devid Bandeira",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "application-loopback": "1.2.7"
  },
  "build": {
    "appId": "dev.telinha.desktop",
    "productName": "Telinha",
    "artifactName": "Telinha-Setup.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "offline.js",
      "picker/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Telinha"
    },
    "extraResources": [
      {
        "from": "node_modules/application-loopback/bin/win32-x64",
        "to": "loopback",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "C:/Windows/System32/msvcp140.dll",
        "to": "loopback/msvcp140.dll"
      },
      {
        "from": "C:/Windows/System32/vcruntime140.dll",
        "to": "loopback/vcruntime140.dll"
      },
      {
        "from": "C:/Windows/System32/vcruntime140_1.dll",
        "to": "loopback/vcruntime140_1.dll"
      }
    ]
  }
}
